# Salin ke .env untuk development, dan isi juga di Cloudflare Pages
# (Settings → Environment variables). Jangan commit .env berisi nilai asli.

# Alamat PocketBase (API publik). Saat development di homelab: http://127.0.0.1:8090
PUBLIC_PB_URL=https://api.cupilstuff.web.id

# Alamat publik bucket R2 (subdomain cdn). Kosongkan untuk memuat file lewat PocketBase.
PUBLIC_CDN_URL=https://cdn.cupilstuff.web.id

# Alamat katalog (dipakai untuk og:image, sitemap, tautan absolut)
PUBLIC_SITE_URL=https://cupilstuff.web.id

# Isi teks QRIS statis toko (scan stiker QRIS dengan aplikasi pembaca QR, salin teksnya).
# Nominal disisipkan otomatis di halaman pesanan berhasil. Kosongkan jika belum ada:
# halaman akan meminta pembeli menghubungi via WhatsApp. Jangan commit nilai aslinya.
PUBLIC_QRIS_STATIS=
