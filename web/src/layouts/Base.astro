---
import { TOKO, linkWA } from "../config";
import MaskotKepala from "../components/MaskotKepala.astro";
import "../styles/tokens.css";

interface Props {
  judul?: string;
  deskripsi?: string;
  gambar?: string;
  pakai3D?: boolean;
  canonical?: string;
}
const { judul, deskripsi = TOKO.tagline, gambar, pakai3D = false, canonical } = Astro.props;
// build.format "file": pathname bisa berakhiran .html (mis. /katalog.html)
const jalur = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "");
const aktif = (href: string) => (jalur === href || jalur.startsWith(`${href}/`) ? "page" : undefined);
const judulLengkap = judul ? `${judul} · ${TOKO.nama}` : `${TOKO.nama} · ${TOKO.tagline}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{judulLengkap}</title>
    <meta name="description" content={deskripsi} />
    <meta property="og:title" content={judulLengkap} />
    <meta property="og:description" content={deskripsi} />
    {gambar && <meta property="og:image" content={gambar} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {pakai3D && (
      <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    )}
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-isi">
        <a href="/" class="brand" aria-label={`${TOKO.nama}, ke halaman awal`}>
          <MaskotKepala ukuran={38} />
          <span>{TOKO.nama}</span>
        </a>
        <nav aria-label="Menu utama">
          <a href="/katalog" aria-current={aktif("/katalog")}>Katalog</a>
          <a href="/servis" aria-current={aktif("/servis")}>Servis</a>
          <a class="nav-tiket" href="/cek-tiket" aria-current={aktif("/cek-tiket")} title="Cek status tiket servis">
            <svg class="ikon-nav" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6z" />
              <path d="M13 5v2M13 11v2M13 17v2" />
            </svg>
            <span class="label-tiket">Cek Tiket</span>
          </a>
          <a class="nav-wa" href={linkWA()} target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
            <svg class="ikon-wa" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" />
            </svg>
            <span class="label-wa">WhatsApp</span>
          </a>
          <a class="nav-keranjang" href="/keranjang" aria-current={aktif("/keranjang")} aria-label="Keranjang" title="Keranjang">
            <svg class="ikon-nav" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 4h2l2.2 10.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2" />
              <circle cx="9.5" cy="19.5" r="1.3" /><circle cx="17" cy="19.5" r="1.3" />
            </svg>
            <span class="badge-keranjang" id="badge-keranjang" hidden></span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-isi">
        <div class="footer-brand">
          <b>{TOKO.nama}</b>
          <p>{TOKO.tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="Navigasi halaman">
          <a href="/katalog">Katalog</a>
          <a href="/servis">Servis</a>
          <a href="/hasil-servis">Hasil servis</a>
          <a href="/cek-tiket">Cek tiket</a>
          <a href="/bayar">Cek pesanan</a>
          <a href="/faq">FAQ</a>
        </nav>
        <div class="footer-info">
          <div class="footer-info-item">
            <b>Jam operasional</b>
            <span>{TOKO.jamOperasional}</span>
          </div>
          <div class="footer-info-item">
            <b>Berdiri sejak</b>
            <span>{TOKO.berdiriSejak}</span>
          </div>
          <div class="footer-info-item">
            <b>Berbasis di</b>
            <span>{TOKO.kota}</span>
          </div>
        </div>
        <div class="footer-aksi">
          <a class="tombol wa footer-wa" href={linkWA()} target="_blank" rel="noopener">
            <svg class="ikon-wa" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>
            Hubungi via WhatsApp
          </a>
        </div>
      </div>
      <p class="footer-bawah">© {new Date().getFullYear()} {TOKO.nama} · {TOKO.kota} · Aktif sejak {TOKO.berdiriSejak}</p>
    </footer>

    <a class="fab-wa" href={linkWA()} target="_blank" rel="noopener" aria-label="Hubungi via WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>
      <span>Hubungi via WhatsApp</span>
    </a>
    <script>
      // jumlah barang di ikon keranjang (header); diperbarui saat keranjang berubah, juga dari tab lain
      import { jumlahBarang, EVENT_BERUBAH, KUNCI } from "../lib/keranjang";
      const badge = document.getElementById("badge-keranjang");
      const tautan = badge?.closest("a");
      // Di /keranjang, halaman mengirim ringkasan (hanya barang yang ikut dipesan);
      // di halaman lain dihitung dari isi keranjang apa adanya.
      let jumlahDariRingkasan: number | null = null;
      window.addEventListener("keranjang:ringkasan", (e) => {
        jumlahDariRingkasan = (e as CustomEvent<{ jumlahBarang: number }>).detail.jumlahBarang;
        perbaruiBadge();
      });
      function perbaruiBadge() {
        if (!badge || !tautan) return;
        const n = jumlahDariRingkasan ?? jumlahBarang();
        badge.hidden = n === 0;
        badge.textContent = n > 99 ? "99+" : String(n);
        tautan.setAttribute("aria-label", n ? `Keranjang, ${n} barang` : "Keranjang");
      }
      window.addEventListener(EVENT_BERUBAH, perbaruiBadge);
      window.addEventListener("storage", (e) => e.key === KUNCI && perbaruiBadge());
      perbaruiBadge();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  /* atribut hidden selalu menang atas display dari CSS komponen */
  [hidden] { display: none !important; }
  /* lompat ke anchor tidak tertutup header yang menempel */
  html { scroll-padding-top: calc(var(--tinggi-header) + 12px); }
  body {
    margin: 0;
    font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  main { max-width: 1100px; margin: 0 auto; padding: 0 20px 48px; flex: 1 0 auto; }

  main { padding-top: 12px; }

  /* header menempel di atas saat scroll */
  .topbar {
    position: sticky; top: 0; z-index: 50; height: var(--tinggi-header);
    background: rgba(246, 245, 242, 0.94); border-bottom: 1px solid var(--line);
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .topbar {
      background: rgba(246, 245, 242, 0.78);
      -webkit-backdrop-filter: saturate(1.4) blur(12px); backdrop-filter: saturate(1.4) blur(12px);
    }
  }
  .topbar-isi {
    max-width: 1100px; height: 100%; margin: 0 auto; padding: 0 20px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.15rem; text-decoration: none; white-space: nowrap; }
  .topbar nav { display: flex; align-items: center; gap: 18px; }
  .topbar nav a { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--muted); white-space: nowrap; }
  .topbar nav a:hover { color: var(--text); }
  .topbar nav a[aria-current="page"] { color: var(--text); font-weight: 600; }
  /* ikon WhatsApp di header ikut hijau saat hover */
  .topbar nav a.nav-wa:hover { color: var(--wa); }
  .ikon-wa { width: 20px; height: 20px; flex: none; }
  .ikon-nav { width: 22px; height: 22px; flex: none; }
  .nav-keranjang { position: relative; }
  .badge-keranjang {
    position: absolute; top: -7px; right: -9px; min-width: 18px; height: 18px; padding: 0 5px;
    border-radius: 999px; background: var(--brand); color: #fff; font-size: 0.7rem; font-weight: 700;
    line-height: 18px; text-align: center;
  }
  /* HP: WhatsApp jadi ikon saja supaya semua muat satu baris mulai 360px */
@media (max-width: 480px) {
    .topbar-isi { padding: 0 14px; }
    .brand { font-size: 1rem; }
    .topbar nav { gap: 10px; font-size: 0.9rem; }
    .label-wa { display: none; }
    .label-tiket { display: none; }
    .nav-wa { padding: 6px; margin: -6px; }
    .nav-tiket { padding: 6px; margin: -6px; }
    .ikon-wa { width: 22px; height: 22px; }
    .nav-keranjang { padding: 6px; margin: -6px; }
  }
  @media (max-width: 400px) {
    .brand > span:last-child { display: none; } /* nama disembunyikan, logo tetap */
    .topbar nav { gap: 8px; }
  }

  footer { background: var(--card); border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
  .footer-isi {
    max-width: 1100px; margin: 0 auto; padding: 32px 20px 20px;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr auto; gap: 28px; align-items: start;
  }
  .footer-brand b { color: var(--text); font-size: 1.15rem; }
  .footer-brand p { margin: 6px 0 0; max-width: 34ch; line-height: 1.5; }
  .footer-nav { display: flex; flex-direction: column; gap: 8px; }
  .footer-nav a { color: var(--muted); text-decoration: none; }
  .footer-nav a:hover { color: var(--brand); }
  .footer-info { display: flex; flex-direction: column; gap: 12px; }
  .footer-info-item { display: flex; flex-direction: column; gap: 2px; }
  .footer-info-item b { color: var(--text); font-weight: 600; }
  .footer-info-item span { color: var(--muted); }
  .footer-aksi { display: flex; flex-direction: column; gap: 10px; }
  .footer-wa { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .footer-wa .ikon-wa { width: 20px; height: 20px; }
  .footer-bawah {
    margin: 0; padding: 16px 20px; text-align: center; border-top: 1px solid var(--line);
    font-size: 0.85rem; color: var(--muted);
  }
  @media (max-width: 760px) {
    .footer-isi { grid-template-columns: 1fr; gap: 22px; padding: 28px 20px 20px; }
  }

  /* tombol WhatsApp melayang di pojok kanan bawah (ikon saja) */
  .fab-wa {
    position: fixed; right: 16px; bottom: 16px; z-index: 100;
    display: inline-flex; align-items: center; justify-content: center;
    width: 60px; height: 60px; border-radius: 50%;
    background: var(--wa); color: #fff;
    box-shadow: 0 8px 24px rgba(22, 163, 74, 0.35), 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: transform 0.15s, background 0.15s;
  }
  .fab-wa svg { width: 30px; height: 30px; flex: none; }
  .fab-wa:hover { background: var(--wa-hover); transform: translateY(-1px); }
  .fab-wa span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .fab-wa { right: 12px; bottom: 12px; width: 56px; height: 56px; }
    .fab-wa svg { width: 28px; height: 28px; }
  }

  /* grid kartu produk (katalog dan landing page): 2 kolom di HP, auto-fill di layar lebar */
  .grid-produk { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  @media (max-width: 559px) {
    .grid-produk { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }

  .tombol {
    display: inline-block; padding: 12px 22px; border-radius: 9999px; font-weight: 600;
    text-decoration: none; text-align: center; border: 1px solid var(--line);
    background: var(--card); color: var(--text); cursor: pointer;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.10);
  }
  /* aksi utama: biru brand, hover sedikit lebih gelap */
  .tombol.utama { background: var(--brand); color: #fff; border-color: var(--brand); }
  .tombol.utama:hover { background: var(--brand-hover); border-color: var(--brand-hover); }
  /* WhatsApp aksi utama: hijau solid, teks putih */
  .tombol.wa { background: var(--wa); color: #fff; border-color: var(--wa); }
  .tombol.wa:hover { background: var(--wa-hover); border-color: var(--wa-hover); }
  /* WhatsApp aksi kedua: garis hijau + teks hijau */
  .tombol.wa-outline { background: var(--card); color: var(--wa); border-color: var(--wa); }
  .tombol.wa-outline:hover { background: var(--wa-soft); }
  .tombol:disabled { opacity: 0.6; cursor: not-allowed; }

  /* notifikasi singkat (lib/notifikasi.ts) */
  .notifikasi {
    position: fixed; left: 50%; bottom: 20px; z-index: 60; transform: translate(-50%, 20px);
    display: flex; gap: 14px; align-items: center; width: max-content; max-width: calc(100vw - 32px);
    padding: 12px 16px; border-radius: 12px; background: var(--text); color: #fff; font-size: 0.95rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); opacity: 0; pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .notifikasi.tampil { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .notifikasi a { color: #9cc2ff; font-weight: 600; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .notifikasi { transition: none; } }

  .kode { font-size: 0.75rem; font-weight: 600; color: var(--muted); letter-spacing: 0.02em; }
  .harga { font-weight: 600; }
  .badge { display: inline-block; font-size: 0.75rem; padding: 2px 8px; border-radius: 999px; background: #eee; }
  .badge.habis { background: var(--habis-bg); color: var(--habis); }
  .badge.preorder { background: var(--banner-bg); color: var(--banner-text); }
  .chip {
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: #fff; cursor: pointer; font-size: 0.9rem; color: var(--text);
  }
  .chip.aktif { background: var(--brand); color: #fff; border-color: var(--brand); }
  /* tersembunyi di layar, tetap dibaca mesin pencari dan pembaca layar */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
