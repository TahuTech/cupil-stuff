---
// Halaman jasa servis: daftar jasa, portofolio sebelum/sesudah, aturan,
// dan form permintaan servis (buka tiket).
import Base from "../layouts/Base.astro";
import Maskot from "../components/Maskot.astro";
import BannerServer from "../components/BannerServer.astro";
import KartuUlasan from "../components/KartuUlasan.astro";
import { TOKO, SERVIS, linkWA } from "../config";
import { ambilJasa, ambilPortofolio, ambilUlasanServis, ambilZonaOngkir, rataBintang } from "../lib/pb";
import { LABEL_PERANGKAT } from "../lib/servis";
import { rupiah, teksPolos } from "../lib/format";

const [jasa, portofolio, zona, ulasanServis] = await Promise.all([
  ambilJasa(),
  ambilPortofolio(),
  ambilZonaOngkir(),
  ambilUlasanServis(),
]);
// provinsi kirim balik dari data zona saat build (sama dengan keranjang): Kota Surabaya paling atas
const provinsi = zona
  .flatMap((z) => z.provinsi)
  .sort((a, b) => (a === "Kota Surabaya" ? -1 : b === "Kota Surabaya" ? 1 : a.localeCompare(b, "id")));
const labelProvinsi = (p: string) => (p === "Jawa Timur" ? "Jawa Timur (selain Kota Surabaya)" : p);

const aturan = [
  { judul: "Tanpa DP", isi: "Perangkat boleh dikirim dulu. Tidak perlu membayar di awal." },
  { judul: "Bayar penuh setelah selesai", isi: "Biaya servis dibayar penuh setelah servis selesai, sesuai estimasi yang sudah kamu setujui." },
  { judul: "Pengecekan gratis", isi: "Tidak ada biaya untuk membuka dan mengecek perangkat." },
  { judul: "Tolak estimasi? Beres.", isi: "Kalau tidak cocok dengan estimasi, perangkat dikirim balik. Kamu hanya menanggung ongkir kirim balik." },
  { judul: "Boleh antar dan ambil langsung", isi: SERVIS.infoAntar },
];
---
<Base judul="Servis mouse dan keyboard" deskripsi={`Servis mouse dan keyboard mechanical di ${TOKO.kota}. Cek gratis, bayar setelah selesai.`}>
  <BannerServer />
  <section class="hero-servis">
    <div>
      <h1>Servis mouse &amp; keyboard</h1>
      <p class="lead">Double-click, scroll lompat, tombol macet, switch mati? Kami cek gratis dan kabari estimasi sebelum dikerjakan.</p>
      <div class="aksi">
        <a class="tombol utama" href="#form-servis">Ajukan servis</a>
        <a class="tombol" href="/hasil-servis">Lihat hasil servis</a>
        <a class="tombol wa-outline" href={linkWA(`Halo ${TOKO.nama}, saya mau tanya soal servis.`)} target="_blank" rel="noopener">Tanya dulu via WhatsApp</a>
      </div>
    </div>
    <Maskot ukuran={130} />
  </section>

  <section class="aturan" aria-labelledby="judul-aturan">
    <h2 id="judul-aturan">Cara kerjanya</h2>
    <ul>
      {aturan.map((a) => (
        <li>
          <b>{a.judul}</b>
          <span>{a.isi}</span>
        </li>
      ))}
    </ul>
  </section>

  {jasa.length > 0 && (
    <section class="jasa" aria-labelledby="judul-jasa">
      <h2 id="judul-jasa">Jenis servis</h2>
      <div class="grid-jasa">
        {jasa.map((j) => (
          <article class="kartu-jasa">
            <span class="kode">{j.kode}{j.perangkat && ` · ${LABEL_PERANGKAT[j.perangkat] ?? j.perangkat}`}</span>
            <h3>{j.nama}</h3>
            {j.deskripsi && <p class="deskripsi" set:html={j.deskripsi} />}
            <p class="harga-mulai">Mulai {rupiah(j.hargaMulai)}</p>
            {j.estimasi && <p class="estimasi">Estimasi {j.estimasi}</p>}
          </article>
        ))}
      </div>
    </section>
  )}

  {portofolio.length > 0 && (
    <section class="portofolio" aria-labelledby="judul-portofolio">
      <h2 id="judul-portofolio">Sebelum &amp; sesudah</h2>
      <div class="grid-portofolio">
        {portofolio.map((p) => (
          <figure class="kartu-portofolio">
            <div class="pasangan">
              {p.fotoSebelum ? <img src={p.fotoSebelum} alt={`Sebelum: ${p.judul}`} loading="lazy" /> : <div class="kosong">sebelum</div>}
              {p.fotoSesudah ? <img src={p.fotoSesudah} alt={`Sesudah: ${p.judul}`} loading="lazy" /> : <div class="kosong">sesudah</div>}
            </div>
            <figcaption>
              <b>{p.judul}</b>
              {p.keterangan && <span>{teksPolos(p.keterangan, 120)}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {ulasanServis.length > 0 && (
    <section class="ulasan" aria-labelledby="judul-ulasan">
      <div class="kepala-bagian">
        <h2 id="judul-ulasan">Kata pembeli</h2>
        {ulasanServis.length >= 3 && (
          <span class="rata" title={`Rata-rata ${rataBintang(ulasanServis)} dari 5`}>
            ⭐ {String(rataBintang(ulasanServis)).replace(".", ",")} <span class="dari">/ 5</span>
          </span>
        )}
      </div>
      <div class="grid-ulasan">
        {ulasanServis.slice(0, 6).map((u) => (
          <KartuUlasan ulasan={u} />
        ))}
      </div>
      <p class="tautan-hasil">
        Lihat portofolio lengkap sebelum/sesudah di <a href="/hasil-servis">hasil servis →</a>
      </p>
    </section>
  )}

  <section class="form-servis" id="form-servis" aria-labelledby="judul-form">
    <h2 id="judul-form">Ajukan servis</h2>
    <p class="keterangan">Isi data di bawah. Kami buatkan nomor tiket supaya kamu bisa memantau status servis. Sudah punya tiket? <a href="/cek-tiket">Cek status tiket</a>.</p>
    <div class="form-layout">
    <form id="servis" novalidate>
      <div class="baris">
        <label class="kolom">
          <span>Jenis servis</span>
          <select id="jasa" name="jasa">
            <option value="">Belum tahu / tanya dulu</option>
            {jasa.map((j) => <option value={j.id}>{j.nama}</option>)}
          </select>
        </label>
        <label class="kolom">
          <span>Perangkat</span>
          <select id="perangkat_jenis" name="perangkat_jenis">
            <option value="mouse">Mouse</option>
            <option value="keyboard">Keyboard</option>
            <option value="lainnya">Lainnya</option>
          </select>
          <small class="galat" data-untuk="perangkat_jenis"></small>
        </label>
      </div>

      <label class="kolom">
        <span>Merek / tipe perangkat</span>
        <input id="perangkat" name="perangkat" maxlength="80" placeholder="Contoh: Logitech G102" required />
        <small class="galat" data-untuk="perangkat"></small>
      </label>

      <label class="kolom">
        <span>Keluhan</span>
        <textarea id="keluhan" name="keluhan" rows="4" maxlength="1000"
          placeholder="Contoh: double click, scroll lompat, switch kiri tidak responsif…" required></textarea>
        <small class="galat" data-untuk="keluhan"></small>
      </label>

      <div class="kolom">
        <span>Foto perangkat <em>(opsional, maks 5)</em></span>
        <label class="upload-dashed" for="foto">
          <svg class="ikon-kamera" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></svg>
          <b>Tambah foto perangkat</b>
          <span>JPG, PNG, atau WebP</span>
          <input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
        </label>
        <small class="bantuan">Foto otomatis dikecilkan sebelum diunggah.</small>
        <small class="galat" data-untuk="foto"></small>
        <ul class="pratinjau" id="pratinjau-foto"></ul>
      </div>

      <div class="baris">
        <label class="kolom">
          <span>Nama</span>
          <input id="nama" name="nama" autocomplete="name" maxlength="80" required />
          <small class="galat" data-untuk="nama"></small>
        </label>
        <label class="kolom">
          <span>WhatsApp</span>
          <input id="wa" name="wa" type="tel" inputmode="tel" autocomplete="tel" placeholder="0812 3456 7890" maxlength="20" required />
          <small class="galat" data-untuk="wa"></small>
        </label>
      </div>

      <fieldset class="cara-kirim">
        <legend>Cara kirim perangkat</legend>
        <label class="pilihan">
          <input type="radio" name="cara_kirim" value="kurir" checked />
          <span><b>Kirim lewat kurir</b><small>Alamat kirim muncul setelah tiket dibuat. Ongkir kirim balik ditanggung pemilik perangkat.</small></span>
        </label>
        <label class="pilihan">
          <input type="radio" name="cara_kirim" value="antar" />
          <span><b>Antar dan ambil langsung</b><small>{SERVIS.infoAntar}</small></span>
        </label>
        <small class="galat" data-untuk="cara_kirim"></small>
      </fieldset>

      <label class="kolom" id="kolom-provinsi">
        <span>Provinsi untuk kirim balik</span>
        <select id="provinsi" name="provinsi">
          <option value="">Pilih provinsi</option>
          {provinsi.map((p) => <option value={p}>{labelProvinsi(p)}</option>)}
        </select>
        <small class="bantuan">Untuk menghitung ongkir kirim balik (J&amp;T, tarif per zona).</small>
        <small class="galat" data-untuk="provinsi"></small>
      </label>

      <div class="galat-umum" id="galat-umum" role="alert" hidden></div>

      <button type="submit" class="tombol utama" id="kirim">Buat tiket servis</button>
      <p class="catatan-kirim" id="catatan-kirim">Nomor tiket dibuat otomatis. Kamu bisa memantau status di halaman cek tiket.</p>
    </form>

    <aside class="form-aside" aria-label="Ringkasan layanan">
      <div class="form-aside-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2 4-4" /></svg>
        <div><b>Cek gratis</b><span>Tidak ada biaya membuka &amp; mengecek perangkat.</span></div>
      </div>
      <div class="form-aside-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h16a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M3 7l13-3v3" /><circle cx="16" cy="13" r="1.2" /></svg>
        <div><b>Tanpa DP</b><span>Bayar penuh setelah selesai, sesuai estimasi yang disetujui.</span></div>
      </div>
      <div class="form-aside-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
        <div><b>Garansi 7 hari</b><span>Keluhan yang sama muncul lagi? Kami perbaiki gratis.</span></div>
      </div>
      <div class="form-aside-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        <div><b>Jam operasional</b><span>{TOKO.jamOperasional}</span></div>
      </div>
      <a class="tombol wa" href={linkWA(`Halo ${TOKO.nama}, saya mau tanya soal servis.`)} target="_blank" rel="noopener">Tanya via WhatsApp</a>
    </aside>
    </div>
  </section>

  <section class="sukses" id="sukses" hidden>
    <Maskot ukuran={120} senangSaatMuncul />
    <h2>Tiket servis dibuat</h2>
    <p class="nomor-tiket">Nomor tiket <b id="nomor-tiket"></b></p>
    <p id="info-kirim" class="info-kirim"></p>
    <div class="aksi">
      <a class="tombol wa" id="wa-tiket" target="_blank" rel="noopener">Hubungi kami via WhatsApp</a>
      <a class="tombol" id="cek-tiket" href="/cek-tiket">Cek status tiket</a>
    </div>
    <p class="simpan">Simpan nomor tiket ini. Kamu perlu 4 digit terakhir WhatsApp untuk mengecek status.</p>
  </section>
</Base>

<script>
  import {
    kecilkanFoto, urlServis, validasiServis, validasiPilihanFoto, MAKS_FOTO_SERVIS,
    type IsianServis, type PesananDibuatServis,
  } from "../lib/servis";
  import { linkWA, TOKO, SERVIS } from "../config";
  import { pantauServer, fetchServer, gagalKarenaServer, aturBannerServer } from "../lib/status-server";
  import { pesanServisWA } from "../lib/pesan-wa";

  const form = document.getElementById("servis") as HTMLFormElement;
  const galatUmum = document.getElementById("galat-umum") as HTMLElement;
  const tombol = document.getElementById("kirim") as HTMLButtonElement;
  const pratinjau = document.getElementById("pratinjau-foto") as HTMLElement;
  const inputFoto = document.getElementById("foto") as HTMLInputElement;
  const kolomProvinsi = document.getElementById("kolom-provinsi") as HTMLElement;
  const catatanKirim = document.getElementById("catatan-kirim");
  let serverMati = false;

  function aturTombol() {
    tombol.textContent = serverMati ? "Ajukan servis via WhatsApp" : "Buat tiket servis";
    // ganti penampilan tombol: brand (aksi utama) ↔ hijau WhatsApp (fallback)
    tombol.classList.toggle("wa", serverMati);
    tombol.classList.toggle("utama", !serverMati);
    if (catatanKirim) {
      catatanKirim.textContent = serverMati
        ? "Pemesanan otomatis sedang tidak tersedia. Isian dikirim lewat WhatsApp; foto perangkat bisa dilampirkan di chat."
        : "Nomor tiket dibuat otomatis. Kamu bisa memantau status di halaman cek tiket.";
    }
  }
  function setServerMati(mati: boolean) {
    serverMati = mati;
    aturBannerServer(mati);
    aturTombol();
  }
  pantauServer(setServerMati);

  const nilai = (id: string) =>
    (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null)?.value ?? "";
  const caraKirim = () => (form.querySelector('input[name="cara_kirim"]:checked') as HTMLInputElement | null)?.value ?? "";
  const isian = (): IsianServis => ({
    nama: nilai("nama"), wa: nilai("wa"), perangkat_jenis: nilai("perangkat_jenis"), perangkat: nilai("perangkat"),
    keluhan: nilai("keluhan"), cara_kirim: caraKirim(), provinsi: nilai("provinsi"), jasa: nilai("jasa"),
  });
  const fotoTerpilih = () => Array.from(inputFoto.files || []);

  // provinsi hanya perlu jika dikirim lewat kurir
  function aturProvinsi() {
    kolomProvinsi.hidden = caraKirim() !== "kurir";
  }
  form.querySelectorAll('input[name="cara_kirim"]').forEach((r) => r.addEventListener("change", aturProvinsi));
  aturProvinsi();

  function tampilkanGalat(galat: Record<string, string>) {
    document.querySelectorAll<HTMLElement>("[data-untuk]").forEach((el) => {
      el.textContent = galat[el.dataset.untuk || ""] || "";
    });
    form.querySelectorAll<HTMLInputElement>("input, select, textarea").forEach((el) => {
      el.setAttribute("aria-invalid", String(!!galat[el.name]));
    });
    const ada = Object.keys(galat).length > 0;
    galatUmum.hidden = !ada;
    galatUmum.textContent = ada ? galat.umum || "Periksa lagi isian yang ditandai merah." : "";
  }

  // pratinjau foto; periksa jumlah dan jenis berkas
  inputFoto.addEventListener("change", () => {
    const berkas = fotoTerpilih();
    pratinjau.replaceChildren(
      ...berkas.slice(0, MAKS_FOTO_SERVIS).map((b) => {
        const li = document.createElement("li");
        const img = document.createElement("img");
        img.src = URL.createObjectURL(b);
        img.alt = "";
        li.appendChild(img);
        return li;
      }),
    );
    const g = validasiPilihanFoto(berkas);
    const el = document.querySelector<HTMLElement>('[data-untuk="foto"]');
    if (el) el.textContent = g;
    inputFoto.setAttribute("aria-invalid", String(!!g));
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = isian();
    const g = validasiServis(data);
    const gFoto = validasiPilihanFoto(fotoTerpilih());
    if (gFoto) g.foto = gFoto;
    tampilkanGalat(g);
    if (Object.keys(g).length) {
      form.querySelector<HTMLElement>(`[name="${Object.keys(g)[0]}"]`)?.focus();
      return;
    }

    tombol.disabled = true;
    tombol.textContent = "Mengirim…";
    try {
      // Mode WhatsApp: server mati → kirim isian lewat WA, foto tetap di form (tidak hilang).
      if (serverMati) {
        const pesan = pesanServisWA(data, fotoTerpilih().length, TOKO.nama, (document.getElementById("jasa") as HTMLSelectElement).selectedOptions[0]?.textContent?.trim() ?? "");
        const jendela = window.open(linkWA(pesan), "_blank");
        if (jendela) jendela.opener = null; // "noopener" di fitur window.open selalu mengembalikan null
        if (!jendela) tampilkanGalat({ umum: "Izinkan jendela baru untuk membuka WhatsApp, lalu tekan tombol lagi." });
        tombol.disabled = false;
        aturTombol();
        return;
      }

      const fd = new FormData();
      for (const [k, v] of Object.entries(data)) fd.set(k, v);
      for (const b of fotoTerpilih()) {
        const kecil = await kecilkanFoto(b);
        fd.append("foto", new File([kecil], b.name.replace(/\.\w+$/, "") + ".jpg", { type: "image/jpeg" }));
      }

      const res = await fetchServer(urlServis(), { method: "POST", body: fd });
      const balas = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 400 && balas.galat) tampilkanGalat({ ...balas.galat, umum: balas.galat.umum ?? balas.pesan });
        else if (res.status === 413) tampilkanGalat({ foto: "Foto terlalu besar. Kurangi jumlah atau ukuran foto." });
        else if (gagalKarenaServer(res.status)) {
          setServerMati(true);
          tampilkanGalat({ umum: "Server sedang tidak tersedia. Tekan lagi untuk mengirim lewat WhatsApp." });
        } else tampilkanGalat({ umum: balas.pesan ?? "Tiket belum bisa dibuat. Coba lagi sebentar." });
        tombol.disabled = false;
        aturTombol();
        return;
      }
      tampilkanSukses(balas as PesananDibuatServis, data.cara_kirim);
    } catch {
      // jaringan / timeout → alihkan ke WhatsApp
      setServerMati(true);
      tampilkanGalat({ umum: "Server tidak bisa dihubungi. Tekan lagi untuk mengirim lewat WhatsApp." });
      tombol.disabled = false;
      aturTombol();
    }
  });

  function tampilkanSukses(hasil: PesananDibuatServis, cara: string) {
    form.closest("section")!.hidden = true;
    const sukses = document.getElementById("sukses") as HTMLElement;
    sukses.hidden = false;
    document.getElementById("nomor-tiket")!.textContent = hasil.nomor;
    document.getElementById("info-kirim")!.textContent =
      cara === "kurir"
        ? `Kirim perangkat ke: ${SERVIS.alamatKirim}. Tulis nomor tiket di paket.`
        : `${SERVIS.infoAntar} Sebutkan nomor tiket saat datang.`;
    const wa = document.getElementById("wa-tiket") as HTMLAnchorElement;
    wa.href = linkWA(`Halo ${TOKO.nama}, saya baru membuat tiket servis ${hasil.nomor}. Mohon info langkah selanjutnya.`);
    (document.getElementById("cek-tiket") as HTMLAnchorElement).href = `/cek-tiket?nomor=${encodeURIComponent(hasil.nomor)}`;
    sukses.scrollIntoView({ behavior: "smooth", block: "start" });
  }
</script>



<style>
  h2 { font-size: 1.25rem; margin: 0 0 12px; }

  .hero-servis {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 16px 0 24px; border-bottom: 1px solid var(--line);
  }
  .hero-servis h1 { margin: 0 0 8px; font-size: 1.6rem; }
  .lead { margin: 0 0 16px; color: var(--muted); max-width: 46ch; }
  .aksi { display: flex; flex-wrap: wrap; gap: 10px; }

  .aturan { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .aturan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .aturan li {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 16px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .aturan li b { font-size: 0.95rem; }
  .aturan li span { color: var(--muted); font-size: 0.9rem; }

  .jasa, .portofolio, .ulasan, .form-servis { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .grid-jasa { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .kartu-jasa { padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .kartu-jasa h3 { margin: 4px 0 8px; font-size: 1.05rem; }
  .kartu-jasa .deskripsi { color: var(--muted); font-size: 0.9rem; margin: 0 0 8px; }
  .kartu-jasa .deskripsi :global(p) { margin: 0; }
  .harga-mulai { font-weight: 700; margin: 8px 0 2px; }
  .estimasi { color: var(--muted); font-size: 0.85rem; margin: 0; }

  .grid-portofolio { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .kartu-portofolio { margin: 0; min-width: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .pasangan { display: grid; grid-template-columns: 1fr 1fr; min-width: 0; }
