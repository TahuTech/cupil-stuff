---
import Base from "../layouts/Base.astro";
import Maskot from "../components/Maskot.astro";
import BannerServer from "../components/BannerServer.astro";
---

<Base judul="Bayar pesanan" deskripsi="Cek dan bayar pesanan Cupil Stuff">
  <BannerServer />
  <section class="bayar" id="layar-masuk" hidden>
    <Maskot ukuran={100} />
    <h1>Cek pesanan</h1>
    <p class="info">Masukkan nomor pesanan dan 4 digit terakhir nomor WhatsApp kamu.</p>
    <form id="form-masuk" class="form" autocomplete="off">
      <label><span>Nomor pesanan</span>
        <input type="text" id="nomor" placeholder="CS-260101-ABCD" required maxlength={20} /></label>
      <label><span>4 digit terakhir WA</span>
        <input type="text" id="wa4" inputmode="numeric" pattern="[0-9]{4}" maxlength={4}
               placeholder="1234" required autocomplete="off" /></label>
      <button type="submit" class="tombol utama" id="btn-cek">Cek pesanan</button>
      <p class="galat" id="galat-masuk" hidden></p>
      <p class="galat" id="galat-server" hidden></p>
    </form>
  </section>

  <section class="bayar" id="layar-pesanan" hidden>
    <Maskot ukuran={110} senangSaatMuncul />
    <h1 id="judul-bayar"></h1>
    <p class="info" id="info-bayar"></p>
    <div class="kotak"><h2>Barang</h2><ul class="rincian" id="rincian"></ul><dl id="angka"></dl></div>
    <div class="kotak" id="bagian-bayar"></div>
  </section>

  <section class="bayar" id="layar-error" hidden>
    <Maskot ukuran={100} />
    <h1 id="judul-error"></h1>
    <p id="pesan-error" class="info"></p>
    <button class="tombol utama" id="btn-kembali">Cek pesanan lain</button>
  </section>
</Base>

<script>
import { rupiah } from "../lib/format";
import { linkWA, TOKO } from "../config";
import { qrisDenganNominal } from "../lib/qris";
import { renderSVG } from "uqr";
import { urlApi } from "../lib/api";
import { linkLacakJNT } from "../lib/lacak";
import { pantauServer, cekServer, fetchServer, gagalKarenaServer, aturBannerServer } from "../lib/status-server";
import { pesanCekPesananWA } from "../lib/pesan-wa";

let serverMati = false;
function setServerMati(mati: boolean) {
  serverMati = mati;
  aturBannerServer(mati);
}
  pantauServer(setServerMati);

const QRIS = (import.meta.env.PUBLIC_QRIS_STATIS || "").trim();

// Bentuk balasan GET /api/pesanan/{nomor} (pocketbase/pb_hooks/pesanan.api.pb.js)
type ItemPesanan = { nama: string; varian_nama?: string; warna?: string | null; jumlah: number; subtotal: number };
type DetailPesanan = {
  nomor: string;
  items: ItemPesanan[];
  ongkir: number;
  potongan_ongkir: number;
  total: number;
  ongkir_konfirmasi: boolean;
  berat_ditagih_kg: number;
  zona: { nama: string; estimasi: string } | null;
  status_bayar: string;
  resi?: string;
};

const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, txt?: string) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (txt) e.textContent = txt;
  return e;
}

function tampil(id: string) {
  ["layar-masuk", "layar-pesanan", "layar-error"].forEach((x) => $(x).hidden = x !== id);
}

function render(ps: DetailPesanan) {
  const sub = ps.total - ps.ongkir + ps.potongan_ongkir;
  if (ps.status_bayar === "lunas") {
    $("judul-bayar").textContent = "Pembayaran diterima ✅";
    $("info-bayar").textContent = ps.resi ? "Resi sudah tersedia." : "Pesanan sedang diproses.";
  } else if (ps.status_bayar === "batal") {
    $("judul-bayar").textContent = "Pesanan dibatalkan";
    $("info-bayar").textContent = "Pesanan ini sudah dibatalkan.";
  } else {
    $("judul-bayar").textContent = "Pesanan " + ps.nomor;
    $("info-bayar").textContent = "Silakan selesaikan pembayaran.";
  }

  $("rincian").replaceChildren(...ps.items.map((it: ItemPesanan) => {
    const li = document.createElement("li");
    const kiri = document.createElement("span");
    let l = it.nama;
    if (it.varian_nama) l += " (" + it.varian_nama + ")";
    if (it.warna) l += ", " + it.warna;
    l += " × " + it.jumlah;
    kiri.textContent = l;
    const kanan = document.createElement("span");
    kanan.textContent = rupiah(it.subtotal);
    li.append(kiri, kanan);
    return li;
  }));

  const baris: [string, string, string?][] = [["Subtotal", rupiah(sub)]];
  if (ps.ongkir_konfirmasi) {
    baris.push(["Ongkir", "dikonfirmasi via WhatsApp"]);
  } else {
    const zt = ps.zona ? ", " + ps.zona.nama : "";
    baris.push(["Ongkir J&T (" + ps.berat_ditagih_kg + " kg" + zt + ")", rupiah(ps.ongkir)]);
    if (ps.potongan_ongkir) baris.push(["Potongan ongkir", "- " + rupiah(ps.potongan_ongkir), "potongan"]);
  }
  baris.push([ps.ongkir_konfirmasi ? "Total barang" : "Total bayar", rupiah(ps.total), "total"]);

  $("angka").replaceChildren(...baris.map(([dt, dd, cls]) => {
    const div = document.createElement("div");
    if (cls) div.className = cls;
    const ddt = document.createElement("dt"); ddt.textContent = dt;
    const ddd = document.createElement("dd"); ddd.textContent = dd;
    div.append(ddt, ddd);
    return div;
  }));

  const b = $("bagian-bayar");
  if (ps.status_bayar === "lunas" && ps.resi) {
    const a = el("a", "tombol utama", "Lacak resi J&T");
    a.href = linkLacakJNT(); // nomor resi ditampilkan di atas; tempel di halaman lacak J&T
    a.target = "_blank";
    b.replaceChildren(el("h2", "", "Resi pengiriman"), el("p", "", "No. resi: " + ps.resi), a);
  } else if (ps.status_bayar === "lunas") {
    b.replaceChildren(el("h2", "", "Menunggu pengiriman"), el("p", "info", "Pesanan segera dikirim."));
  } else if (ps.ongkir_konfirmasi) {
    const a = el("a", "tombol wa", "Hubungi via WhatsApp");
    a.href = linkWA("Halo " + TOKO.nama + ", cek ongkir pesanan " + ps.nomor + ".");
    a.target = "_blank";
    b.replaceChildren(el("h2", "", "Langkah berikutnya"), el("p", "info", "Ongkir perlu dikonfirmasi dulu."), a);
  } else if (ps.status_bayar === "menunggu") {
    const total = rupiah(ps.total);
    let qris = "";
    let ok = false;
    if (QRIS && ps.total > 0) {
      try { qris = qrisDenganNominal(QRIS, ps.total); ok = true; } catch (e) {}
    }
    b.replaceChildren(el("h2", "", "Pembayaran"));
    if (ok) {
      b.appendChild(el("p", "nominal", total));
      const qr = el("div", "qr");
      qr.innerHTML = renderSVG(qris, { ecc: "M", border: 2 }); // dari teks QRIS, bukan hasil encode()
      b.appendChild(qr);
    }
    b.appendChild(el("p", "langkah-bayar", "1. Scan QRIS dengan aplikasi bank/e-wallet.\n2. Bayar sesuai nominal.\n3. Kirim bukti bayar via WhatsApp."));
    const wa = el("a", "tombol wa", "Kirim bukti bayar via WhatsApp");
    wa.href = linkWA("Halo " + TOKO.nama + ", sudah bayar pesanan " + ps.nomor + " sebesar " + total + ". Bukti terlampir.");
    wa.target = "_blank"; wa.rel = "noopener";
    b.appendChild(wa);
  }
  tampil("layar-pesanan");
}

const p = new URLSearchParams(location.search);
const nUrl = p.get("nomor");
if (nUrl) { $<HTMLInputElement>("nomor").value = nUrl; $("wa4").focus(); }

$("form-masuk").addEventListener("submit", async (e) => {
  e.preventDefault();
  const nomor = $<HTMLInputElement>("nomor").value.trim();
  const wa4 = $<HTMLInputElement>("wa4").value.trim();
  const btn = $<HTMLButtonElement>("btn-cek");
  const galat = $("galat-masuk");
  const galatServer = $("galat-server");
  galatServer.hidden = true;

  // Server mati: pengecekan tidak tersedia, tawarkan WA berisi nomor pesanan.
  // cek ulang tanpa cache: bisa jadi server sudah hidup lagi
  if (serverMati && (await cekServer(true)) !== "mati") setServerMati(false);
  if (serverMati) {
    tampilkanTidakTersedia(nomor);
    return;
  }
  if (!nomor || wa4.length !== 4 || !/^\d{4}$/.test(wa4)) {
    galat.textContent = "Isi nomor pesanan dan 4 digit WA.";
    galat.hidden = false;
    return;
  }
  btn.disabled = true; btn.textContent = "Mengecek..."; galat.hidden = true;
  try {
    const r = await fetchServer(urlApi("/api/pesanan/" + encodeURIComponent(nomor) + "?wa=" + wa4));
    const bd = await r.json();
    if (!r.ok) {
      if (r.status === 429) galat.textContent = bd.pesan || "Terlalu banyak percobaan.";
      else if (r.status === 403) galat.textContent = "4 digit terakhir tidak cocok.";
      else if (r.status === 404) {
        $("judul-error").textContent = "Pesanan tidak ditemukan";
        $("pesan-error").textContent = "Periksa nomor pesanan.";
        tampil("layar-error");
        btn.disabled = false; btn.textContent = "Cek pesanan";
        return;
      } else if (gagalKarenaServer(r.status)) {
        setServerMati(true);
        tampilkanTidakTersedia(nomor);
        btn.disabled = false; btn.textContent = "Cek pesanan";
        return;
      } else galat.textContent = bd.pesan || "Gagal.";
      galat.hidden = false;
      btn.disabled = false; btn.textContent = "Cek pesanan";
      return;
    }
    render(bd);
  } catch (er) {
    setServerMati(true);
    tampilkanTidakTersedia(nomor);
  }
  btn.disabled = false; btn.textContent = "Cek pesanan";
});

// Server mati: pesan + tautan WA berisi nomor pesanan yang diketik.
function tampilkanTidakTersedia(nomor: string) {
  const galatServer = $("galat-server");
  galatServer.replaceChildren(document.createTextNode("Pengecekan sedang tidak tersedia. "));
  const a = document.createElement("a");
  a.href = linkWA(pesanCekPesananWA(nomor, TOKO.nama));
  a.target = "_blank";
  a.rel = "noopener";
  a.textContent = "Hubungi via WhatsApp";
  galatServer.appendChild(a);
  galatServer.hidden = false;
}

$("btn-kembali").addEventListener("click", () => {
  tampil("layar-masuk");
  $<HTMLInputElement>("nomor").value = ""; $<HTMLInputElement>("wa4").value = "";
});

tampil("layar-masuk");
</script>

<style>
  .bayar { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 16px 0; }
  h1 { margin: 12px 0 4px; font-size: 1.4rem; }
  .info { margin: 0 0 16px; color: var(--muted); max-width: 42ch; }
  .form { width: 100%; max-width: 360px; display: grid; gap: 10px; }
  .form label { display: grid; gap: 4px; text-align: left; font-size: 0.9rem; color: var(--muted); }
  .form label span { font-weight: 600; color: var(--text); font-size: 0.85rem; }
  .form input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); letter-spacing: 0.04em; }
  .form input:focus { border-color: var(--brand); outline: none; box-shadow: 0 0 0 3px var(--brand-ring); }
  #wa4 { text-align: center; font-size: 1.4rem; letter-spacing: 0.3em; max-width: 120px; justify-self: center; }
  .galat { color: var(--habis); font-size: 0.85rem; margin: 0; }
  .kotak { width: 100%; max-width: 480px; margin-top: 12px; padding: 16px 18px; text-align: left; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .kotak h2 { margin: 0 0 10px; font-size: 1rem; }
  .rincian { list-style: none; margin: 0 0 12px; padding: 0 0 12px; border-bottom: 1px solid var(--line); display: grid; gap: 6px; }
  .rincian :global(li), #angka :global(div) { display: flex; justify-content: space-between; gap: 12px; }
  .rincian :global(li span:last-child) { white-space: nowrap; }
  #angka { margin: 0; display: grid; gap: 6px; }
  #angka :global(dt) { color: var(--muted); }
  #angka :global(dd) { margin: 0; font-weight: 600; text-align: right; }
  #angka :global(.potongan dd) { color: var(--sukses); }
  #angka :global(.total) { margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--line); }
  #angka :global(.total dt), #angka :global(.total dd) { color: var(--text); font-size: 1.15rem; font-weight: 700; }
  #bagian-bayar { display: flex; flex-direction: column; gap: 12px; }
  #bagian-bayar :global(h2) { margin: 0; }
  #bagian-bayar :global(.info) { margin: 0; color: var(--muted); }
  #bagian-bayar :global(.nominal) { margin: 0; font-size: 1.6rem; font-weight: 800; text-align: center; }
  #bagian-bayar :global(.qr) { align-self: center; width: min(280px, 100%); background: #fff; border-radius: 12px; padding: 8px; border: 1px solid var(--line); }
  #bagian-bayar :global(.qr svg) { display: block; width: 100%; height: auto; }
  #bagian-bayar :global(.langkah-bayar) { margin: 4px 0 0; color: var(--muted); font-size: 0.88rem; white-space: pre-line; }
  #btn-kembali { margin-top: 16px; }
</style>
