# Salin ke .env (di homelab). Jangan commit .env berisi nilai asli.
# Semua nilai rahasia KOSONG dengan sengaja: kamu yang mengisi sendiri.
# Jangan pernah menempelkan nilai rahasia ke chat, commit, atau log.

# ---------- Cloudflare Tunnel ----------
# Zero Trust -> Networks -> Tunnels -> token connector.
# Tanpa token, cloudflared tidak jalan dan api.cupilstuff.web.id tidak bisa diakses.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Cloudflare Pages ----------
# Settings -> Builds -> Deploy hooks. Dipakai hook PocketBase untuk build ulang katalog
# saat produk/varian/zona/stok berubah. Kosong = build ulang otomatis dilewati.
PAGES_DEPLOY_HOOK=

# ---------- Alamat publik ----------
# Wajib di produksi (dicek scripts/siapkan-pocketbase.mjs dan scripts/cek-produksi.sh).
SITE_URL=https://cupilstuff.web.id
API_URL=https://api.cupilstuff.web.id
# Origin katalog yang boleh memanggil API PocketBase dari browser (CORS), dipisah koma.
# Produksi: HANYA katalog. Untuk development, kosongkan baris ini (compose memakai
# http://localhost:4321,http://127.0.0.1:4321) atau isi origin localhost yang dipakai.
PB_ORIGINS=https://cupilstuff.web.id

# ---------- Notifikasi Telegram pemilik toko ----------
# Lihat README bagian "Notifikasi Telegram". Kosong = notifikasi dilewati.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Cloudflare R2 (file + backup) ----------
# Endpoint S3 dari dashboard R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Token R2 dibuat khusus untuk bucket ini (Object Read & Write), jangan token global.
R2_ENDPOINT=
R2_BUCKET=cupilstuff-files
# Bucket tujuan backup harian. Kosong = pakai R2_BUCKET yang sama.
R2_BACKUP_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- SMTP (email sistem + peringatan login superuser) ----------
# Port 587 dengan STARTTLS (SMTP_TLS=true). Port 465 -> SMTP_TLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# ---------- Katalog Astro (dibaca saat BUILD, bukan oleh PocketBase) ----------
# Di produksi diisi di Cloudflare Pages -> Settings -> Environment variables, BUKAN di sini.
# Dicantumkan supaya daftarnya lengkap; salinan untuk development ada di web/.env.example.
# Build produksi (npm run build) GAGAL bila salah satu dari empat ini kosong.
# PUBLIC_PB_URL=https://api.cupilstuff.web.id
# PUBLIC_CDN_URL=https://cdn.cupilstuff.web.id
# PUBLIC_SITE_URL=https://cupilstuff.web.id
# PUBLIC_QRIS_STATIS=

# ---------- Skrip admin (jangan disimpan di berkas ini) ----------
# scripts/siapkan-pocketbase.mjs membutuhkan PB_EMAIL dan PB_PASSWORD (akun superuser).
# Ketik saat menjalankan skrip, lihat docs/GO-LIVE.md bagian 5.
