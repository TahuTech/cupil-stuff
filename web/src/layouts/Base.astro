---
import { TOKO, linkWA } from "../config";

interface Props {
  judul?: string;
  deskripsi?: string;
  gambar?: string;
  pakai3D?: boolean;
}
const { judul, deskripsi = TOKO.tagline, gambar, pakai3D = false } = Astro.props;
const jalur = Astro.url.pathname.replace(/\/$/, "");
const aktif = (href: string) => (jalur === href || jalur.startsWith(`${href}/`) ? "page" : undefined);
const judulLengkap = judul ? `${judul} · ${TOKO.nama}` : `${TOKO.nama} · ${TOKO.tagline}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{judulLengkap}</title>
    <meta name="description" content={deskripsi} />
    <meta property="og:title" content={judulLengkap} />
    <meta property="og:description" content={deskripsi} />
    {gambar && <meta property="og:image" content={gambar} />}
    {pakai3D && (
      <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    )}
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="brand">{TOKO.nama}</a>
      <nav>
        <a href="/katalog" aria-current={aktif("/katalog")}>Katalog</a>
        <a href="/servis" aria-current={aktif("/servis")}>Servis</a>
        <a href={linkWA()} target="_blank" rel="noopener">WhatsApp</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p><b>{TOKO.nama}</b> · {TOKO.kota}</p>
      <p class="tautan-footer">
        <a href={linkWA()} target="_blank" rel="noopener">WhatsApp</a>
        {TOKO.marketplace.map((m) => <a href={m.url} target="_blank" rel="noopener">{m.nama}</a>)}
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f5f2;
    --card: #fff;
    --text: #1d1d1f;
    --muted: #6b6b70;
    --accent: #1f6feb;
    --wa: #25d366;
    --line: #e4e2dd;
    --habis: #b42318;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  main { max-width: 1100px; margin: 0 auto; padding: 0 20px 48px; }

  .topbar {
    max-width: 1100px; margin: 0 auto; padding: 16px 20px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .brand { font-weight: 700; font-size: 1.2rem; text-decoration: none; }
  .topbar nav { display: flex; gap: 16px; }
  .topbar nav a { text-decoration: none; color: var(--muted); }
  .topbar nav a:hover { color: var(--text); }
  .topbar nav a[aria-current="page"] { color: var(--text); font-weight: 600; }
  @media (max-width: 400px) {
    .topbar { padding: 14px 16px; }
    .topbar nav { gap: 12px; font-size: 0.95rem; }
  }

  footer { text-align: center; color: var(--muted); font-size: 0.9rem; padding: 24px; border-top: 1px solid var(--line); }
  footer p { margin: 4px 0; }
  .tautan-footer { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }

  /* grid kartu produk (katalog dan landing page): 2 kolom di HP, auto-fill di layar lebar */
  .grid-produk { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  @media (max-width: 559px) {
    .grid-produk { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }

  .tombol {
    display: inline-block; padding: 12px 22px; border-radius: 12px; font-weight: 600;
    text-decoration: none; text-align: center; border: 1px solid var(--line); background: #fff;
  }
  .tombol.utama { background: var(--text); color: #fff; border-color: var(--text); }
  .tombol.wa { background: var(--wa); color: #fff; border-color: var(--wa); }

  .kode { font-size: 0.75rem; font-weight: 700; color: var(--accent); letter-spacing: 0.04em; }
  .harga { font-weight: 600; }
  .badge { display: inline-block; font-size: 0.75rem; padding: 2px 8px; border-radius: 999px; background: #eee; }
  .badge.habis { background: #fde8e7; color: var(--habis); }
  .badge.preorder { background: #fff3cd; color: #7a5b00; }
  .chip {
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: #fff; cursor: pointer; font-size: 0.9rem; color: var(--text);
  }
  .chip.aktif { background: var(--text); color: #fff; border-color: var(--text); }
  /* tersembunyi di layar, tetap dibaca mesin pencari dan pembaca layar */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
