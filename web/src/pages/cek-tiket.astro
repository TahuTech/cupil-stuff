---
// Halaman /cek-tiket: masukkan nomor tiket + 4 digit terakhir WA untuk melihat status servis.
import Base from "../layouts/Base.astro";
import Maskot from "../components/Maskot.astro";
import { TOKO } from "../config";
---
<Base judul="Cek status tiket servis" deskripsi={`Cek status servis di ${TOKO.nama}.`}>
  <section class="cek" id="layar-masuk" hidden>
    <Maskot ukuran={100} />
    <h1>Cek status tiket</h1>
    <p class="info">Masukkan nomor tiket servis dan 4 digit terakhir nomor WhatsApp kamu.</p>
    <form id="form-cek" class="form" autocomplete="off">
      <label>
        <span>Nomor tiket</span>
        <input type="text" id="nomor" placeholder="SRV-260101-ABCD" required maxlength={20} />
      </label>
      <label>
        <span>4 digit terakhir WA</span>
        <input type="text" id="wa4" inputmode="numeric" pattern="[0-9]{4}" maxlength={4}
               placeholder="1234" required autocomplete="off" />
      </label>
      <button type="submit" class="tombol utama" id="btn-cek">Cek tiket</button>
      <p class="galat" id="galat" hidden></p>
    </form>
  </section>

  <section class="cek" id="layar-tiket" hidden>
    <Maskot ukuran={110} senangSaatMuncul />
    <h1 id="judul-tiket"></h1>
    <p class="nomor">Tiket <b id="nomor-tiket"></b></p>

    <ol class="langkah" id="langkah" aria-label="Tahapan servis"></ol>

    <div class="kotak">
      <dl id="detail"></dl>
    </div>

    <div class="kotak" id="bagian-biaya" hidden></div>
  </section>

  <section class="cek" id="layar-error" hidden>
    <Maskot ukuran={100} />
    <h1 id="judul-error"></h1>
    <p id="pesan-error" class="info"></p>
    <button class="tombol utama" id="btn-kembali">Cek tiket lain</button>
  </section>
</Base>

<script>
  import { rupiah } from "../lib/format";
  import { linkWA, TOKO } from "../config";
  import { urlTiket } from "../lib/servis";
  import { qrisDenganNominal } from "../lib/qris";
  import { encode, renderSVG } from "uqr";

  const QRIS_STATIS = (import.meta.env.PUBLIC_QRIS_STATIS || "").trim();

  // Bentuk balasan GET /api/tiket (lihat responsPublik di pocketbase/pb_hooks/servis.js).
  // Semua angka, termasuk tagihan, dihitung di server.
  type Tagihan = {
    jenis: "servis" | "kirim_balik" | "tidak_ada";
    biaya: number | null;
    ongkir_kirim_balik: number | null;
    total: number | null;
    perlu_bayar: boolean;
  };
  type DetailTiket = {
    nomor: string;
    status: string;
    status_label: string;
    jasa: string | null;
    perangkat: string;
    estimasi_biaya: number | null;
    biaya_final: number | null;
    ongkir_kirim_balik: number | null;
    tagihan: Tagihan | null;
    dibuat: string;
    diperbarui: string;
  };

  // urutan langkah yang ditampilkan ke pembeli
  const LANGKAH: [string, string][] = [
    ["menunggu_perangkat", "Menunggu perangkat"],
    ["diterima", "Diterima"],
    ["dicek", "Dicek"],
    ["menunggu_persetujuan", "Menunggu persetujuan"],
    ["dikerjakan", "Dikerjakan"],
    ["selesai", "Selesai"],
    ["dikirim", "Dikirim"],
  ];
  // estimasi ditolak: berhenti setelah "menunggu persetujuan", lalu dikembalikan
  const LANGKAH_DIKEMBALIKAN: [string, string][] = [...LANGKAH.slice(0, 4), ["dikembalikan", "Dikembalikan"]];

  const $ = (id: string) => document.getElementById(id)!;
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, txt?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (txt) e.textContent = txt;
    return e;
  }
  function tampil(id: string) {
    ["layar-masuk", "layar-tiket", "layar-error"].forEach((x) => ($(x).hidden = x !== id));
  }
  function tanggal(iso: string) {
    if (!iso) return "–";
    const d = new Date(iso.replace(" ", "T"));
    return isNaN(d.getTime()) ? "–" : d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
  }
  function tautanWA(teks: string, pesan: string) {
    const a = el("a", "tombol wa", teks);
    a.href = linkWA(pesan);
    a.target = "_blank";
    a.rel = "noopener";
    return a;
  }

  function renderLangkah(status: string) {
    const daftar = status === "dikembalikan" ? LANGKAH_DIKEMBALIKAN : LANGKAH;
    const posisi = daftar.findIndex(([s]) => s === status);
    $("langkah").replaceChildren(
      ...daftar.map(([s, label], i) => {
        const li = el("li", i < posisi ? "lewat" : i === posisi ? "sekarang" : "nanti");
        li.append(el("span", "titik", i < posisi ? "✓" : String(i + 1)), el("span", "label", label));
        if (i === posisi) li.setAttribute("aria-current", "step");
        li.dataset.status = s;
        return li;
      }),
    );
  }

  /** QR + unduh + tombol bukti bayar untuk nominal dari server. */
  function bagianBayar(nominal: number, nomor: string, untuk: string) {
    const isi: HTMLElement[] = [el("p", "nominal", rupiah(nominal))];
    let qris = "";
    try {
      qris = QRIS_STATIS ? qrisDenganNominal(QRIS_STATIS, nominal) : "";
    } catch {
      qris = ""; // isi QRIS tidak dicatat ke console
    }
    if (qris) {
      const qr = el("div", "qr");
      qr.setAttribute("role", "img");
      qr.setAttribute("aria-label", `Kode QRIS untuk membayar ${rupiah(nominal)}`);
      qr.innerHTML = renderSVG(qris, { ecc: "M", border: 2 }); // SVG buatan library dari string QRIS
      const unduh = el("button", "tombol", "Simpan gambar QR");
      unduh.type = "button";
      unduh.addEventListener("click", () => unduhPNG(qris, `QRIS-${nomor}.png`));
      isi.push(qr, unduh, el("p", "info", "Scan dengan aplikasi bank atau e-wallet (kalau bayar dari HP ini, simpan gambar QR lalu buka dari aplikasinya). Pastikan nominalnya sesuai, lalu kirim bukti bayar."));
    } else {
      isi.push(el("p", "info", "Pembayaran QRIS belum tersedia. Kami kirim cara bayar lewat WhatsApp."));
    }
    isi.push(tautanWA("Kirim bukti bayar via WhatsApp", `Halo ${TOKO.nama}, saya sudah membayar ${untuk} tiket ${nomor} sebesar ${rupiah(nominal)}. Bukti bayar saya lampirkan.`));
    return isi;
  }

  function unduhPNG(isi: string, namaBerkas: string) {
    const qr = encode(isi, { ecc: "M", border: 4 });
    const skala = 10;
    const c = document.createElement("canvas");
    c.width = c.height = qr.size * skala;
    const ctx = c.getContext("2d")!;
    ctx.fillStyle = "#fff";
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.fillStyle = "#000";
    qr.data.forEach((baris, y) => baris.forEach((hitam, x) => hitam && ctx.fillRect(x * skala, y * skala, skala, skala)));
    c.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = namaBerkas;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }, "image/png");
  }

  function baris(dt: string, dd: string, kelas = "") {
    const div = el("div", kelas);
    div.append(el("dt", "", dt), el("dd", "", dd));
    return div;
  }

  function renderTiket(tk: DetailTiket) {
    $("judul-tiket").textContent = tk.status_label;
    $("nomor-tiket").textContent = tk.nomor;
    renderLangkah(tk.status);

    const detail = [];
    if (tk.jasa) detail.push(baris("Jenis servis", tk.jasa));
    detail.push(baris("Perangkat", tk.perangkat || "–"), baris("Dibuat", tanggal(tk.dibuat)), baris("Terakhir diperbarui", tanggal(tk.diperbarui)));
    $("detail").replaceChildren(...detail);

    const biaya = $("bagian-biaya");
    const isi: HTMLElement[] = [];
    const tg = tk.tagihan;

    if (tk.status === "menunggu_persetujuan") {
      isi.push(el("h2", "", "Estimasi biaya servis"));
      if (tk.estimasi_biaya) {
        const est = rupiah(tk.estimasi_biaya);
        isi.push(el("p", "nominal", est));
        const tolak = tk.ongkir_kirim_balik === 0
          ? "Kalau tidak setuju, perangkat bisa diambil langsung tanpa biaya."
          : tk.ongkir_kirim_balik
            ? `Kalau tidak setuju, perangkat kami kirim balik dan kamu hanya membayar ongkir ${rupiah(tk.ongkir_kirim_balik)}.`
            : "Kalau tidak setuju, perangkat kami kirim balik dan kamu hanya membayar ongkir kirim balik.";
        isi.push(el("p", "info", `Pengecekan gratis. Servis dikerjakan setelah kamu setuju, dan dibayar setelah selesai. ${tolak}`));
        isi.push(tautanWA("Setuju, kerjakan", `Halo ${TOKO.nama}, untuk tiket ${tk.nomor}: saya SETUJU dengan estimasi ${est}. Silakan dikerjakan.`));
        const tolakWA = tautanWA("Tidak setuju, kembalikan", `Halo ${TOKO.nama}, untuk tiket ${tk.nomor}: saya TIDAK SETUJU dengan estimasi ${est}. Mohon perangkat dikembalikan.`);
        tolakWA.className = "tombol tolak";
        isi.push(tolakWA);
      } else {
        isi.push(el("p", "info", "Estimasi biaya sedang kami siapkan dan akan dikabari lewat WhatsApp."));
      }
    } else if (tg && tg.jenis === "servis") {
      isi.push(el("h2", "", "Tagihan servis"));
      const dl = el("dl", "rincian");
      dl.append(baris("Biaya servis", tg.biaya !== null ? rupiah(tg.biaya) : "dikabari via WhatsApp"));
      dl.append(baris("Ongkir kirim balik", tg.ongkir_kirim_balik === 0 ? "– (ambil langsung)" : tg.ongkir_kirim_balik !== null ? rupiah(tg.ongkir_kirim_balik) : "dikabari via WhatsApp"));
      if (tg.total !== null) dl.append(baris("Total", rupiah(tg.total), "total"));
      isi.push(dl);
      if (tg.total !== null && tg.total > 0) isi.push(...bagianBayar(tg.total, tk.nomor, "servis"));
      else isi.push(el("p", "info", "Total tagihan akan kami kabari lewat WhatsApp."));
    } else if (tg && tg.jenis === "kirim_balik") {
      isi.push(el("h2", "", "Ongkir kirim balik"));
      isi.push(el("p", "info", "Estimasi tidak disetujui, jadi tidak ada biaya servis. Kamu hanya membayar ongkir kirim balik."));
      if (tg.total !== null && tg.total > 0) isi.push(...bagianBayar(tg.total, tk.nomor, "ongkir kirim balik"));
      else isi.push(el("p", "info", "Ongkir kirim balik akan kami kabari lewat WhatsApp."));
    } else if (tg && tg.jenis === "tidak_ada") {
      isi.push(el("h2", "", "Tidak ada tagihan"));
      isi.push(el("p", "info", "Estimasi tidak disetujui dan perangkat diambil langsung, jadi tidak ada biaya sama sekali."));
    }
    biaya.replaceChildren(...isi);
    biaya.hidden = isi.length === 0;

    tampil("layar-tiket");
  }

  const params = new URLSearchParams(location.search);
  const nomorUrl = params.get("nomor");
  if (nomorUrl) {
    ($("nomor") as HTMLInputElement).value = nomorUrl;
    ($("wa4") as HTMLInputElement).focus();
  }

  $("form-cek").addEventListener("submit", async (e) => {
    e.preventDefault();
    const nomor = ($("nomor") as HTMLInputElement).value.trim().toUpperCase();
    const wa4 = ($("wa4") as HTMLInputElement).value.trim();
    const btn = $("btn-cek") as HTMLButtonElement;
    const galat = $("galat");
    if (!nomor || !/^\d{4}$/.test(wa4)) {
      galat.textContent = "Isi nomor tiket dan 4 digit terakhir WA.";
      galat.hidden = false;
      return;
    }
    btn.disabled = true;
    btn.textContent = "Mengecek…";
    galat.hidden = true;
    try {
      const res = await fetch(`${urlTiket()}/${encodeURIComponent(nomor)}?wa=${wa4}`);
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        renderTiket(data as DetailTiket);
      } else if (res.status === 404) {
        $("judul-error").textContent = "Tiket tidak ditemukan";
        $("pesan-error").textContent = "Periksa kembali nomor tiketmu. Kalau baru membuat tiket, tunggu sebentar lalu coba lagi.";
        tampil("layar-error");
      } else {
        galat.textContent =
          res.status === 403 ? "4 digit terakhir tidak cocok." : data.pesan || "Gagal mengecek. Coba lagi nanti.";
        galat.hidden = false;
      }
    } catch {
      galat.textContent = "Tidak bisa terhubung ke server. Coba lagi.";
      galat.hidden = false;
    }
    btn.disabled = false;
    btn.textContent = "Cek tiket";
  });

  $("btn-kembali").addEventListener("click", () => {
    tampil("layar-masuk");
    ($("nomor") as HTMLInputElement).value = "";
    ($("wa4") as HTMLInputElement).value = "";
  });

  tampil("layar-masuk");
</script>

<style>
  .cek { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 16px 0; }
  h1 { margin: 12px 0 4px; font-size: 1.4rem; }
  .info { margin: 0 0 16px; color: var(--muted); max-width: 42ch; }
  .nomor { margin: 0 0 8px; color: var(--muted); }
  .nomor b { color: var(--text); font-size: 1.1rem; letter-spacing: 0.03em; }
  .form { width: 100%; max-width: 360px; display: grid; gap: 10px; }
  .form label { display: grid; gap: 4px; text-align: left; }
  .form label span { font-weight: 600; font-size: 0.85rem; }
  .form input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .form input:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px var(--primary-alpha); }
  #wa4 { text-align: center; font-size: 1.4rem; letter-spacing: 0.3em; max-width: 120px; justify-self: center; }
  .galat { color: #d32f2f; font-size: 0.85rem; margin: 0; }
  .kotak { width: 100%; max-width: 480px; margin-top: 12px; padding: 16px 18px; text-align: left; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .kotak h2 { margin: 0 0 10px; font-size: 1rem; }
  #detail { margin: 0; display: grid; gap: 8px; }
  #detail :global(div) { display: flex; justify-content: space-between; gap: 12px; }
  #detail :global(dt) { color: var(--muted); }
  #detail :global(dd) { margin: 0; font-weight: 600; text-align: right; }
  #bagian-biaya { display: flex; flex-direction: column; gap: 10px; }
  #bagian-biaya :global(.nominal) { margin: 0; font-size: 1.5rem; font-weight: 800; }
  #bagian-biaya :global(.info) { margin: 0; color: var(--muted); }
  #bagian-biaya :global(.qr) { align-self: center; width: min(260px, 100%); background: #fff; border-radius: 12px; padding: 8px; border: 1px solid var(--line); }
  #bagian-biaya :global(.qr svg) { display: block; width: 100%; height: auto; }
  #btn-kembali { margin-top: 16px; }

  /* tahapan status */
  .langkah { list-style: none; margin: 8px 0 4px; padding: 0; width: 100%; max-width: 480px; display: grid; gap: 0; text-align: left; }
  .langkah :global(li) { position: relative; display: flex; align-items: center; gap: 12px; padding: 6px 0; color: var(--muted); }
  .langkah :global(li:not(:last-child))::after {
    content: ""; position: absolute; left: 13px; top: 32px; bottom: -6px; width: 2px; background: var(--line);
  }
  .langkah :global(li.lewat:not(:last-child))::after { background: #1a7f37; }
  .langkah :global(.titik) {
    flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 700; background: var(--card); border: 2px solid var(--line); position: relative; z-index: 1;
  }
  .langkah :global(li.lewat .titik) { background: #1a7f37; border-color: #1a7f37; color: #fff; }
  .langkah :global(li.sekarang) { color: var(--text); font-weight: 700; }
  .langkah :global(li.sekarang .titik) { background: var(--text); border-color: var(--text); color: #fff; }
  #bagian-biaya :global(.rincian) { margin: 0; display: grid; gap: 6px; }
  #bagian-biaya :global(.rincian div) { display: flex; justify-content: space-between; gap: 12px; }
  #bagian-biaya :global(.rincian dt) { color: var(--muted); }
  #bagian-biaya :global(.rincian dd) { margin: 0; font-weight: 600; text-align: right; }
  #bagian-biaya :global(.rincian .total) { padding-top: 8px; border-top: 1px solid var(--line); }
  #bagian-biaya :global(.rincian .total dt), #bagian-biaya :global(.rincian .total dd) { color: var(--text); font-weight: 700; }
  #bagian-biaya :global(button.tombol) { font: inherit; font-weight: 600; cursor: pointer; }
  /* elemen di bawah dibuat lewat JS, jadi perlu :global */
  #bagian-biaya :global(h2) { margin: 0; font-size: 1.05rem; }
  #bagian-biaya :global(.tombol.tolak) { background: var(--card); color: var(--text); border: 1px solid var(--line); }
  @media (max-width: 480px) { h1 { font-size: 1.25rem; } }
</style>

