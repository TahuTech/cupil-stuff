---
import Base from "../layouts/Base.astro";
import Maskot from "../components/Maskot.astro";
---
<Base judul="Halaman tidak ditemukan">
  <section class="tidak-ketemu">
    <Maskot ukuran={160} />
    <h1>Halamannya tidak ketemu</h1>
    <p>Mungkin link-nya salah ketik atau produknya sudah tidak dijual.</p>
    <a class="tombol utama" href="/katalog">Lihat katalog</a>
  </section>
</Base>

<style>
  .tidak-ketemu { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 32px 0 16px; }
  h1 { margin: 20px 0 6px; font-size: 1.4rem; }
  p { margin: 0 0 20px; color: var(--muted); }
</style>
