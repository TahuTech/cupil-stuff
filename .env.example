# Salin ke .env (di homelab). Jangan commit .env.

# Token Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token connector)
CLOUDFLARE_TUNNEL_TOKEN=

# URL deploy hook Cloudflare Pages (Settings → Builds → Deploy hooks).
# Kosongkan jika belum ada; build ulang otomatis akan dilewati.
PAGES_DEPLOY_HOOK=

# Origin katalog yang boleh memanggil API PocketBase dari browser (CORS), dipisah koma.
# Kosongkan untuk development (default: http://localhost:4321,http://127.0.0.1:4321).
# Produksi, misalnya: PB_ORIGINS=https://cupilstuff.id
PB_ORIGINS=

# Alamat katalog, misalnya https://cupilstuff.id (untuk tautan /bayar dan /cek-tiket di pesan WhatsApp).
# Jika kosong, pesan WhatsApp dikirim tanpa tautan.
SITE_URL=

# Alamat PocketBase publik, misalnya https://api.cupilstuff.id (untuk link ke panel admin di notifikasi Telegram)
API_URL=

# Notifikasi Telegram ke pemilik toko (pesanan baru, tiket baru, ongkir perlu konfirmasi). Lihat README.
# Kosongkan untuk mematikan notifikasi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
