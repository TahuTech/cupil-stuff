---
// Halaman setelah checkout berhasil. Data pesanan (angka dari server) dibaca dari
// sessionStorage yang diisi halaman keranjang; nomor pesanan juga ada di URL (#CS-…).
import Base from "../layouts/Base.astro";
import Maskot from "../components/Maskot.astro";
import { TOKO } from "../config";
---
<Base judul="Pesanan berhasil" deskripsi={`Pesanan ${TOKO.nama} berhasil dibuat.`}>
  <section class="berhasil" id="berhasil" hidden>
    <Maskot ukuran={110} senangSaatMuncul />
    <h1>Pesanan berhasil dibuat</h1>
    <p class="nomor">Nomor pesanan <b id="nomor"></b></p>

    <div class="kotak">
      <h2>Rincian</h2>
      <ul class="rincian" id="rincian"></ul>
      <dl id="angka"></dl>
    </div>

    <div class="kotak" id="bagian-bayar"></div>
  </section>

  <section class="tidak-ada" id="tidak-ada" hidden>
    <h1>Data pesanan tidak ditemukan</h1>
    <p>Jika kamu baru saja membuat pesanan, kirim nomor pesanannya ke kami lewat WhatsApp.</p>
    <a class="tombol utama" href="/katalog">Kembali ke katalog</a>
  </section>
</Base>

<script>
  import { KUNCI_PESANAN, type PesananDibuat } from "../lib/checkout";
  import { rupiah } from "../lib/format";
  import { linkWA, TOKO } from "../config";
  import { qrisDenganNominal } from "../lib/qris";
  import { encode, renderSVG } from "uqr";

  const QRIS_STATIS = (import.meta.env.PUBLIC_QRIS_STATIS || "").trim();

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, kelas?: string, teks?: string) {
    const e = document.createElement(tag);
    if (kelas) e.className = kelas;
    if (teks !== undefined) e.textContent = teks;
    return e;
  }
  function tombolWA(teks: string, pesan: string) {
    const a = el("a", "tombol wa", teks);
    a.href = linkWA(pesan);
    a.target = "_blank";
    a.rel = "noopener";
    return a;
  }

  /** Unduh QR sebagai PNG (untuk bayar dari HP yang sama: buka gambar di aplikasi bank/e-wallet). */
  function unduhPNG(isi: string, namaBerkas: string) {
    const qr = encode(isi, { ecc: "M", border: 4 });
    const skala = 10;
    const c = document.createElement("canvas");
    c.width = c.height = qr.size * skala;
    const ctx = c.getContext("2d")!;
    ctx.fillStyle = "#fff";
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.fillStyle = "#000";
    qr.data.forEach((baris, y) => baris.forEach((hitam, x) => hitam && ctx.fillRect(x * skala, y * skala, skala, skala)));
    c.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = namaBerkas;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }, "image/png");
  }

  function renderBayar(ps: PesananDibuat) {
    const bayar = $("bagian-bayar");
    const total = rupiah(ps.total);

    // ongkir perlu dikonfirmasi: jangan tampilkan QRIS
    if (ps.ongkir_konfirmasi) {
      bayar.replaceChildren(
        el("h2", "", "Langkah berikutnya"),
        el("p", "info", `${ps.alasan_konfirmasi || "Ongkir dikonfirmasi via WhatsApp"}. Kami kirim total akhir dan cara bayar lewat WhatsApp.`),
        tombolWA("Konfirmasi ongkir via WhatsApp", `Halo ${TOKO.nama}, saya membuat pesanan ${ps.nomor} (total barang ${total}, dikirim ke ${ps.provinsi}). Mohon info ongkirnya.`),
        el("p", "info", `Setelah ongkir dikonfirmasi, kamu bisa mengecek dan membayar di halaman bayar:`),
      );
      const linkBayar = el("a", "tombol utama", "Cek halaman bayar");
      linkBayar.href = `/bayar?nomor=${encodeURIComponent(ps.nomor)}`;
      bayar.appendChild(linkBayar);
      return;
    }

    const pesanBukti = `Halo ${TOKO.nama}, saya sudah membayar pesanan ${ps.nomor} sebesar ${total}. Bukti bayar saya lampirkan.`;
    let qris = "";
    try {
      qris = QRIS_STATIS ? qrisDenganNominal(QRIS_STATIS, ps.total) : "";
    } catch {
      qris = ""; // isi QRIS tidak dicatat ke console
    }
    if (!qris) {
      bayar.replaceChildren(
        el("h2", "", "Pembayaran"),
        el("p", "info", `Pembayaran QRIS belum tersedia. Hubungi kami lewat WhatsApp untuk membayar ${total}.`),
        tombolWA("Hubungi via WhatsApp", `Halo ${TOKO.nama}, saya mau membayar pesanan ${ps.nomor} sebesar ${total}.`),
      );
      return;
    }

    const gambar = el("div", "qr");
    gambar.setAttribute("role", "img");
    gambar.setAttribute("aria-label", `Kode QRIS untuk membayar ${total}`);
    gambar.innerHTML = renderSVG(qris, { ecc: "M", border: 2 }); // SVG buatan library dari string QRIS
    const unduh = el("button", "tombol", "Simpan gambar QR");
    unduh.type = "button";
    unduh.addEventListener("click", () => unduhPNG(qris, `QRIS-${ps.nomor}.png`));

    const langkah = el("ol", "langkah-bayar");
    for (const t of [
      "Scan QR di atas dengan aplikasi bank atau e-wallet. Kalau bayar dari HP ini, simpan gambar QR lalu buka dari aplikasinya.",
      `Pastikan nominalnya ${total}, lalu bayar.`,
      "Kirim bukti bayar lewat tombol WhatsApp di bawah. Pesanan diproses setelah pembayaran dikonfirmasi.",
    ]) langkah.appendChild(el("li", "", t));

    bayar.replaceChildren(
      el("h2", "", "Bayar dengan QRIS"),
      el("p", "nominal", total),
      gambar,
      unduh,
      langkah,
      tombolWA("Kirim bukti bayar via WhatsApp", pesanBukti),
    );
    // Link ke halaman /bayar untuk mengecek status nanti
    const linkBayar = el("p", "info", "Nanti, cek status pembayaran dan resi di halaman bayar:");
    bayar.appendChild(linkBayar);
    const btnBayar = el("a", "tombol utama", "Cek halaman bayar");
    btnBayar.href = `/bayar?nomor=${encodeURIComponent(ps.nomor)}`;
    bayar.appendChild(btnBayar);
  }

  const $ = (id: string) => document.getElementById(id)!;
  let ps: PesananDibuat | null = null;
  try {
    ps = JSON.parse(sessionStorage.getItem(KUNCI_PESANAN) || "null");
  } catch {}
  const nomorUrl = decodeURIComponent(location.hash.slice(1));
  if (ps && nomorUrl && ps.nomor !== nomorUrl) ps = null;

  if (!ps) {
    $("tidak-ada").hidden = false;
  } else {
    $("berhasil").hidden = false;
    $("nomor").textContent = ps.nomor;

    $("rincian").replaceChildren(
      ...ps.items.map((it) => {
        const li = document.createElement("li");
        const kiri = document.createElement("span");
        kiri.textContent = `${it.nama}${it.varian_nama ? ` (${it.varian_nama})` : ""}${it.warna ? `, ${it.warna}` : ""} × ${it.jumlah}`;
        const kanan = document.createElement("span");
        kanan.textContent = rupiah(it.subtotal);
        li.append(kiri, kanan);
        return li;
      }),
    );

    const baris: [string, string, string?][] = [["Subtotal", rupiah(ps.subtotal)]];
    if (ps.ongkir_konfirmasi) {
      baris.push(["Ongkir", "dikonfirmasi via WhatsApp"]);
    } else {
      baris.push([`Ongkir J&T (${ps.berat_ditagih_kg} kg${ps.zona ? `, ${ps.zona.nama}` : ""})`, rupiah(ps.ongkir)]);
      if (ps.potongan_ongkir) baris.push(["Potongan ongkir", `− ${rupiah(ps.potongan_ongkir)}`, "potongan"]);
    }
    baris.push([ps.ongkir_konfirmasi ? "Total barang" : "Total bayar", rupiah(ps.total), "total"]);
    $("angka").replaceChildren(
      ...baris.map(([dt, dd, kelas]) => {
        const div = document.createElement("div");
        if (kelas) div.className = kelas;
        const t = document.createElement("dt");
        t.textContent = dt;
        const d = document.createElement("dd");
        d.textContent = dd;
        div.append(t, d);
        return div;
      }),
    );

    renderBayar(ps);
  }
</script>

<style>
  .berhasil, .tidak-ada { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 16px 0; }
  h1 { margin: 12px 0 4px; font-size: 1.4rem; }
  .nomor { margin: 0 0 16px; color: var(--muted); }
  .nomor b { color: var(--text); font-size: 1.1rem; letter-spacing: 0.03em; }
  .kotak {
    width: 100%; max-width: 480px; margin-top: 12px; padding: 16px 18px; text-align: left;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .kotak h2 { margin: 0 0 10px; font-size: 1rem; }
  .rincian { list-style: none; margin: 0 0 12px; padding: 0 0 12px; border-bottom: 1px solid var(--line); display: grid; gap: 6px; }
  .rincian :global(li), #angka :global(div) { display: flex; justify-content: space-between; gap: 12px; }
  .rincian :global(li span:last-child) { white-space: nowrap; }
  #angka { margin: 0; display: grid; gap: 6px; }
  #angka :global(dt) { color: var(--muted); }
  #angka :global(dd) { margin: 0; font-weight: 600; text-align: right; }
  #angka :global(.potongan dd) { color: var(--sukses); }
  #angka :global(.total) { margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--line); }
  #angka :global(.total dt), #angka :global(.total dd) { color: var(--text); font-size: 1.15rem; font-weight: 700; }
  .tidak-ada p { color: var(--muted); max-width: 40ch; }

  #bagian-bayar { display: flex; flex-direction: column; gap: 12px; }
  #bagian-bayar :global(h2) { margin: 0; }
  #bagian-bayar :global(.info) { margin: 0; color: var(--muted); }
  #bagian-bayar :global(.nominal) { margin: 0; font-size: 1.6rem; font-weight: 800; text-align: center; }
  #bagian-bayar :global(.qr) { align-self: center; width: min(280px, 100%); background: #fff; border-radius: 12px; padding: 8px; border: 1px solid var(--line); }
  #bagian-bayar :global(.qr svg) { display: block; width: 100%; height: auto; }
  #bagian-bayar :global(button.tombol) { font: inherit; font-weight: 600; cursor: pointer; }
  #bagian-bayar :global(.langkah-bayar) { margin: 0; padding-left: 20px; color: var(--muted); font-size: 0.9rem; display: grid; gap: 6px; }
</style>
