# Salin ke .env untuk development, dan isi juga di Cloudflare Pages
# (Settings → Environment variables).

# Alamat PocketBase. Saat development di homelab: http://127.0.0.1:8090
PUBLIC_PB_URL=https://api.cupilstuff.example

# Alamat publik bucket R2 (subdomain cdn). Kosongkan untuk memuat file lewat PocketBase.
PUBLIC_CDN_URL=https://cdn.cupilstuff.example

# Alamat katalog setelah online
PUBLIC_SITE_URL=https://cupilstuff.example
