---
import Base from "../layouts/Base.astro";
import KartuProduk from "../components/KartuProduk.astro";
import KartuUlasan from "../components/KartuUlasan.astro";
import Maskot from "../components/Maskot.astro";
import { ambilKatalog, ambilUlasan, pilihProdukUnggulan } from "../lib/pb";
import { TOKO, linkWA } from "../config";

const { produk } = await ambilKatalog();
const pilihan = pilihProdukUnggulan(produk);
const ulasanUnggulan = await ambilUlasan({ unggulan: true }, 4); // maks. 4 ulasan unggulan
// nama produk untuk judul ulasan (jika jenis produk)
const namaProduk = new Map(produk.map((p) => [p.id, p.nama]));

const lini = [
  {
    judul: "Model 3D",
    teks: "Figur dan pernak-pernik cetak 3D buatan sendiri. Bisa diputar dalam 3D dan pilih warnanya.",
    href: "/katalog?lini=model3d",
    ikon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v12l-8 4-8-4V6z"/><path d="M12 22V12"/><path d="M4 6l8 4 8-4"/></svg>',
  },
  {
    judul: "Barang EDC",
    teks: "Pisau lipat, peluit, dan perlengkapan kecil lain untuk dibawa sehari-hari.",
    href: "/katalog?lini=edc",
    ikon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>',
  },
  {
    judul: "Servis mouse, keyboard &amp; controller",
    teks: "Perbaikan mouse, keyboard, dan controller/joystick (analog drift). Pengecekan gratis, bayar setelah selesai.",
    href: "/servis",
    ikon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.1 2.1-2.1-2.1z"/></svg>',
  },
];

const langkah = [
  { judul: "Pilih produk", teks: "Buka katalog, pilih varian, warna, dan jumlahnya." },
  { judul: "Pilih provinsi", teks: "Ongkir dihitung otomatis sesuai zona dan berat kiriman." },
  { judul: "Bayar QRIS", teks: "Scan QRIS dengan nominal yang sudah terisi, lalu kirim bukti bayar via WhatsApp." },
];
---
<Base deskripsi={`${TOKO.deskripsiSEO} "${TOKO.tagline}"`}>
  <section class="hero">
    <div class="hero-teks">
      <h1>Model 3D, barang EDC, dan servis mouse, keyboard &amp; controller</h1>
      <p>Model 3D dibuat sendiri di {TOKO.kota}. Lihat produknya dalam 3D, pilih varian, lalu bayar pakai QRIS.</p>
    </div>
    <div class="hero-aksi">
      <a class="tombol utama" href="/katalog">Lihat katalog</a>
      <a class="tombol wa-outline" href={linkWA(`Halo ${TOKO.nama}, saya mau tanya.`)} target="_blank" rel="noopener">Tanya via WhatsApp</a>
    </div>
    <Maskot ukuran={180} class="hero-maskot" />
  </section>

  <section class="bagian" aria-labelledby="judul-lini">
    <h2 id="judul-lini" class="sr-only">Yang ada di {TOKO.nama}</h2>
    <div class="lini">
      {lini.map((l) => (
        <a class="kartu-lini" href={l.href}>
          <span class="ico" aria-hidden="true" set:html={l.ikon} />
          <h3>{l.judul} <span aria-hidden="true">→</span></h3>
          <p>{l.teks}</p>
        </a>
      ))}
    </div>
  </section>

  {pilihan.length > 0 && (
    <section class="bagian" aria-labelledby="judul-pilihan">
      <div class="kepala-bagian">
        <h2 id="judul-pilihan">Produk pilihan</h2>
        <a href="/katalog">Lihat semua →</a>
      </div>
      <div class="grid-produk">
        {pilihan.map((p) => <KartuProduk produk={p} />)}
      </div>
    </section>
  )}

  {ulasanUnggulan.length > 0 && (
    <section class="bagian" aria-labelledby="judul-ulasan">
      <h2 id="judul-ulasan">Kata pembeli</h2>
      <div class="grid-ulasan">
        {ulasanUnggulan.map((u) => (
          <KartuUlasan
            ulasan={u}
            judul={u.jenis === "produk" && u.produk ? namaProduk.get(u.produk) : undefined}
          />
        ))}
      </div>
    </section>
  )}

  <section class="bagian" aria-labelledby="judul-cara">
    <h2 id="judul-cara">Cara pesan</h2>
    <ol class="langkah">
      {langkah.map((l, i) => (
        <li>
          <span class="nomor" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{l.judul}</h3>
            <p>{l.teks}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bagian ongkir" aria-labelledby="judul-ongkir">
    <h2 id="judul-ongkir">Pengiriman</h2>
    <div class="info-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="17.5" cy="18.5" r="2.5"/></svg>
      <p>Dikirim dari {TOKO.kota} lewat J&amp;T. Ada potongan ongkir <b>Rp 5.000</b> untuk setiap <b>Rp 100.000</b> belanja (paling banyak sebesar ongkirnya).</p>
    </div>
  </section>
</Base>

<style>
  /* hero: teks di kiri, maskot di kanan (110px di HP, 180px di desktop) */
  /* desktop: teks + tombol di kiri, maskot di kanan; HP: tombol pindah ke bawah, lebar penuh */
  .hero {
    display: grid; grid-template-columns: minmax(0, 560px) auto; column-gap: 56px; align-items: center;
    grid-template-areas: "teks maskot" "aksi maskot"; justify-content: start; padding: 12px 0 8px;
  }
  .hero-teks { grid-area: teks; }
  .hero-aksi { grid-area: aksi; align-self: start; }
  .hero :global(.hero-maskot) { grid-area: maskot; }
  .hero h1 { margin: 0 0 10px; font-size: 2rem; line-height: 1.2; }
  .hero p { margin: 0 0 20px; color: var(--muted); font-size: 1.05rem; }
  .hero-aksi { display: flex; flex-wrap: wrap; gap: 10px; }

  .bagian { padding: 28px 0 0; }
  .bagian h2 { margin: 0 0 14px; font-size: 1.25rem; }
  .kepala-bagian { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .kepala-bagian a { color: var(--brand); text-decoration: none; font-weight: 600; white-space: nowrap; }

  .lini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .kartu-lini {
    display: flex; flex-direction: column; gap: 6px; padding: 18px 20px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.10);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .kartu-lini:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08); border-color: #d7dbe2; }
  .kartu-lini .ico {
    width: 38px; height: 38px; border-radius: 11px; margin-bottom: 4px;
    display: grid; place-items: center; background: var(--brand-soft); color: var(--brand);
  }
  .kartu-lini .ico :global(svg) { width: 22px; height: 22px; }
  .kartu-lini h3 { margin: 0; font-size: 1.05rem; }
  .kartu-lini h3 span { color: var(--brand); }
  .kartu-lini p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }

  .langkah { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .langkah li { display: flex; gap: 14px; align-items: flex-start; }
  .nomor {
    flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    background: var(--text); color: #fff; font-weight: 700;
  }
  .langkah h3 { margin: 4px 0 2px; font-size: 1rem; }
  .langkah p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .ongkir p { margin: 0; }
  .info-box {
    display: flex; gap: 14px; align-items: flex-start;
    background: var(--brand-soft); border: 1px solid #dbe6ff; border-radius: var(--radius);
    padding: 16px 18px; max-width: 60ch;
  }
  .info-box svg { width: 22px; height: 22px; color: var(--brand); flex: none; margin-top: 2px; }
  .info-box b { color: var(--brand); }

  .grid-ulasan { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }

  @media (max-width: 759px) {
    .lini, .langkah { grid-template-columns: 1fr; gap: 10px; }
    .langkah { gap: 16px; }
  }
  @media (max-width: 559px) {
    .hero { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "teks maskot" "aksi aksi"; column-gap: 12px; align-items: start; }
    .hero h1 { font-size: 1.35rem; }
    .hero p { font-size: 0.95rem; margin-bottom: 16px; }
    .hero :global(.hero-maskot) { width: 110px; }
    .hero-aksi .tombol { flex: 1 1 0; padding: 11px 10px; white-space: nowrap; }
    .kartu-lini { padding: 14px 16px; }
    .grid-ulasan { grid-template-columns: 1fr; }
  }
</style>
